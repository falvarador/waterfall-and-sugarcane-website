---
import StarRating from "./StarRating.astro";

export interface Props {
  quote: string;
  name: string;
  role?: string;
  avatar?: string;
  initials: string;
  rating?: number;
}

const { quote, name, role = "Visitante", avatar, initials, rating = 5 } = Astro.props;
---

<article
  class="bg-surface p-7 rounded-2xl border border-border shadow-sm hover:shadow-xl hover:scale-[1.02] transition-all duration-200 flex flex-col h-full service-card"
  data-reveal
>
  <!-- Comillas decorativas -->
  <div class="text-4xl text-accent font-serif -ml-1 mb-3 leading-none" aria-hidden="true">&#8220;</div>

  <!-- Cita -->
  <blockquote class="text-text-muted text-[0.95rem] leading-relaxed mb-6 flex-grow italic">
    {quote}
  </blockquote>

  <!-- Autor -->
  <footer class="flex items-center gap-3 mt-auto">
    {
      avatar ? (
        <img
          src={avatar}
          alt={`Foto de ${name}`}
          class="w-11 h-11 rounded-full object-cover shrink-0"
          loading="lazy"
          width="44"
          height="44"
        />
      ) : (
        <div
          class="w-11 h-11 rounded-full bg-primary text-white flex items-center justify-center font-bold text-base shrink-0"
          aria-hidden="true"
        >
          {initials}
        </div>
      )
    }
    <div>
      <p class="font-semibold text-text text-sm">{name}</p>
      <p class="text-text-muted text-xs">{role}</p>
      <StarRating rating={rating} />
    </div>
  </footer>
</article>
