---
export interface Props {
  step: number;
  title: string;
  description: string;
  isLast?: boolean;
}

const { step, title, description, isLast = false } = Astro.props;
---

<div class="relative flex flex-col items-center text-center">
  <!-- Número de paso (decorativo, no semántico) -->
  <div
    class="relative z-10 w-16 h-16 rounded-full bg-primary flex items-center justify-center mb-5 shadow-md shadow-primary/30"
    aria-hidden="true"
  >
    <span class="font-serif text-2xl font-bold text-white">{step}</span>
  </div>

  <!-- Conector horizontal (solo en desktop, si no es el último paso) -->
  {
    !isLast && (
      <div
        class="absolute top-8 left-[calc(50%+2rem)] w-[calc(100%-4rem)] h-0.5 bg-border hidden lg:block"
        aria-hidden="true"
      />
    )
  }

  <!-- Slot para ícono -->
  <div class="mb-4">
    <slot name="icon" />
  </div>

  <h3 class="font-serif text-lg font-bold text-text mb-2">{title}</h3>
  <p class="text-text-muted text-sm leading-relaxed max-w-[200px]">{description}</p>
</div>
