---
export interface Props {
  title: string;
  description: string;
  price?: string;
}

const { title, description, price } = Astro.props;
---

<article
  class="service-card group bg-surface border border-border rounded-2xl p-7 flex flex-col gap-4 shadow-sm hover:shadow-xl hover:scale-[1.02] transition-all duration-200 cursor-default"
  data-reveal
>
  <!-- Slot para ícono -->
  <div class="w-12 h-12 rounded-xl bg-surface-raised flex items-center justify-center group-hover:bg-primary/10 transition-colors duration-200">
    <slot name="icon" />
  </div>

  <!-- Contenido -->
  <div class="flex-grow">
    <h3 class="font-serif text-xl font-bold text-text mb-2">{title}</h3>
    <p class="text-text-muted text-sm leading-relaxed">{description}</p>
  </div>

  {
    price && (
      <div class="pt-3 border-t border-border">
        <span class="text-primary font-semibold text-sm">{price}</span>
      </div>
    )
  }
</article>
