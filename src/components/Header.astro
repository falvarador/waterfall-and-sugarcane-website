---
import SocialLinks from "./SocialLinks.astro";
import IconRenderer, { Icon } from "../utilities/IconRenderer.astro";

const navLinks = [
  { label: "Inicio", href: "#inicio" },
  { label: "Nosotros", href: "#nosotros" },
  { label: "Servicios", href: "#servicios" },
  { label: "Testimonios", href: "#testimonios" },
  { label: "Contacto", href: "#contacto" },
];

const logoIconClasses = "h-8 w-8 text-primary";
---

<header
  id="site-header"
  class="sticky top-0 z-50 transition-all duration-300 bg-white/80 backdrop-blur-sm border-b border-transparent shadow-none"
>
  <div
    class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 flex justify-between items-center"
  >
    <!-- Logo -->
    <a href="#inicio" class="flex items-center gap-2 shrink-0">
      <IconRenderer icon={Icon.Leaf} class={logoIconClasses} />
      <span class="text-xl font-bold text-text"
        >Waterfall & Sugarcane El Flaco</span
      >
    </a>

    <!-- Nav desktop -->
    <nav
      class="hidden lg:flex items-center gap-7"
      aria-label="Navegación principal"
    >
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="text-text-muted hover:text-primary transition-colors duration-200 text-sm font-medium"
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <!-- Acciones desktop -->
    <div class="hidden lg:flex items-center gap-4">
      <SocialLinks />
      <!-- CTA Reservar (task 9.2) -->
      <a
        href="#contacto"
        class="inline-flex items-center gap-1.5 bg-primary hover:bg-primary-dark text-white text-sm font-bold px-5 py-2.5 rounded-full transition-all duration-200 hover:shadow-md hover:shadow-primary/30 hover:scale-[1.02]"
      >
        Reservar visita
      </a>
    </div>

    <!-- Menú hamburguesa mobile -->
    <header-menu class="relative lg:hidden">
      <button
        aria-label="Abrir menú"
        aria-expanded="false"
        data-menu-button
        class="p-2 text-text hover:text-primary transition-colors"
      >
        <svg
          class="w-6 h-6"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          data-icon-open
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 6h16M4 12h16m-7 6h7"></path>
        </svg>
        <svg
          class="w-6 h-6 hidden"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          data-icon-close
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>

      <!-- Menú mobile desplegable -->
      <div
        class="absolute top-[calc(100%+16px)] right-0 w-64 bg-surface/95 backdrop-blur-md border border-border rounded-2xl shadow-xl p-4 hidden flex-col gap-1"
        data-mobile-menu
      >
        <nav class="flex flex-col gap-1" aria-label="Menú móvil">
          {
            navLinks.map((link) => (
              <a
                href={link.href}
                class="text-text-muted hover:text-primary hover:bg-surface-raised px-4 py-2.5 rounded-xl text-sm font-medium transition-colors duration-200"
                data-menu-link
              >
                {link.label}
              </a>
            ))
          }
        </nav>
        <div class="border-t border-border mt-2 pt-3 flex flex-col gap-2">
          <a
            href="#contacto"
            class="w-full text-center bg-primary hover:bg-primary-dark text-white text-sm font-bold px-5 py-2.5 rounded-full transition-all duration-200"
            data-menu-link
          >
            Reservar visita
          </a>
          <div class="flex justify-center">
            <SocialLinks />
          </div>
        </div>
      </div>
    </header-menu>
  </div>

  <script>
    // Glassmorphism scroll effect — añade clase 'scrolled' al header
    const header = document.getElementById("site-header");
    if (header) {
      const onScroll = () => {
        if (window.scrollY > 50) {
          header.classList.add("scrolled");
          header.classList.remove("bg-white/80");
          header.classList.add("bg-white/90", "shadow-sm", "border-border");
        } else {
          header.classList.remove(
            "scrolled",
            "shadow-sm",
            "border-border",
            "bg-white/90",
          );
          header.classList.add("bg-white/80");
        }
      };
      window.addEventListener("scroll", onScroll, { passive: true });
      onScroll(); // check initial state
    }

    // Custom element para menú mobile (preservado del original)
    class HeaderMenu extends HTMLElement {
      private isMenuOpen: boolean;
      private menuButton: HTMLButtonElement | null;
      private mobileMenu: HTMLDivElement | null;
      private iconOpen: SVGElement | null;
      private iconClose: SVGElement | null;

      constructor() {
        super();
        this.isMenuOpen = false;
        this.menuButton = null;
        this.mobileMenu = null;
        this.iconOpen = null;
        this.iconClose = null;
      }

      connectedCallback() {
        this.menuButton = this.querySelector("[data-menu-button]");
        this.mobileMenu = this.querySelector("[data-mobile-menu]");
        this.iconOpen = this.querySelector("[data-icon-open]");
        this.iconClose = this.querySelector("[data-icon-close]");

        if (this.menuButton) {
          this.menuButton.addEventListener("click", this.toggleMenu.bind(this));
        }

        this.querySelectorAll("[data-menu-link]").forEach((link) => {
          link.addEventListener("click", this.closeMenu.bind(this));
        });

        this.updateVisibility();
      }

      toggleMenu() {
        this.isMenuOpen = !this.isMenuOpen;
        this.updateVisibility();
      }

      closeMenu() {
        this.isMenuOpen = false;
        this.updateVisibility();
      }

      updateVisibility() {
        if (this.mobileMenu) {
          this.mobileMenu.classList.toggle("hidden", !this.isMenuOpen);
          this.mobileMenu.classList.toggle("flex", this.isMenuOpen);
          this.iconOpen?.classList.toggle("hidden", this.isMenuOpen);
          this.iconClose?.classList.toggle("hidden", !this.isMenuOpen);
          this.menuButton?.setAttribute(
            "aria-expanded",
            this.isMenuOpen.toString(),
          );
        }
      }

      disconnectedCallback() {
        if (this.menuButton)
          this.menuButton.removeEventListener("click", this.toggleMenu);

        this.querySelectorAll("[data-menu-link]").forEach((link) => {
          link.removeEventListener("click", this.closeMenu);
        });
      }
    }

    customElements.define("header-menu", HeaderMenu);
  </script>
</header>
