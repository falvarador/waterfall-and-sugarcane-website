---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import SocialProof from "../components/SocialProof.astro";
import Services from "../components/Services.astro";
import Testimonials from "../components/Testimonials.astro";
import HowItWorks from "../components/HowItWorks.astro";
import ContactBlock from "../components/ContactBlock.astro";
import Location from "../components/Location.astro";
import Footer from "../components/Footer.astro";
---

<Layout>
  <Header />
  <main>
    <!-- 1. Hero — propuesta de valor + CTAs principales -->
    <Hero />

    <!-- 2. SocialProof — métricas numéricas + rating (early trust signal) -->
    <SocialProof />

    <!-- 3. Services — propuesta de valor expandida con tarjetas -->
    <Services />

    <!-- 4. Testimonials — prueba social cualitativa -->
    <Testimonials />

    <!-- 5. HowItWorks — proceso de visita paso a paso -->
    <HowItWorks />

    <!-- 6. ContactBlock — formulario + WhatsApp + teléfono -->
    <ContactBlock />

    <!-- 7. Location — mapa / ubicación -->
    <Location />
  </main>
  <Footer />
</Layout>
