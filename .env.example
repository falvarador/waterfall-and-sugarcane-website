# ─────────────────────────────────────────────
# Variables de entorno públicas del sitio
# Copiar este archivo a `.env` y completar los valores reales
# ─────────────────────────────────────────────

# Número de WhatsApp en formato internacional (sin + ni espacios)
# Ejemplo: 50687654321
PUBLIC_WHATSAPP_NUMBER=50687654321

# URL del endpoint de Formspree para el formulario de contacto
# Obtener en https://formspree.io → My Forms → Endpoints
PUBLIC_FORMSPREE_URL=https://formspree.io/f/XXXXXXXX
